# .env.example - کپی کنید به .env و مقداردهی کنید. چیزی از این فایل
# commit نشود اگر مقدار واقعی گذاشتید (SERVICE_JWT_SECRET مثلا).

# --- vLLM ---
VLLM_API_BASE=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct-AWQ
TEMPERATURE=0.2
MAX_TOKENS=800

# --- روتر تخصص (ParsBERT) ---
# مسیر پوشه‌ای که ParsBert/train.py با --epochs ... تولید کرده (final/).
# در production باید یک مسیر mount شده باشد (نگاه کنید به MODEL_WEIGHTS.md)، نه چیزی داخل ایمیج.
PARSBERT_MODEL_DIR=/mnt/models/parsbert-specialty/final

# --- تریاژ اورژانس (fastText) ---
TRIAGE_MODEL_PATH=/mnt/models/triage_model.bin

# --- RAG ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=spin_kb
RAG_TOP_K=5

# --- امنیت (فعلا stub - نگاه کنید به app/api/deps.py) ---
SERVICE_JWT_SECRET=change-me-coordinate-with-backend-team

# --- ظرفیت هم‌زمان (docker/api.Dockerfile) ---
# تعداد پردازه uvicorn. هر پردازه یک نسخه کامل ParsBERT+embedder را در RAM
# جدا بار می‌کند - قبل از بالابردن این عدد، مصرف RAM را چک کنید. مقدار
# درست را با scripts/load_test.py تعیین کنید، حدس نزنید.
WEB_CONCURRENCY=2
