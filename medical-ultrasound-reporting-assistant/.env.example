# Project Configuration
PROJECT_NAME=BuAli
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=9002
API_WORKERS=4
INTERNAL_API_TOKEN=your-secret-token-here

# GPU
CUDA_VISIBLE_DEVICES=0
TORCH_HOME=./models

# Services
STT_SERVICE_URL=http://localhost:8000
LLM_SERVICE_URL=http://localhost:8001
EVAL_SERVICE_URL=http://localhost:8002
CONTENT_FILTER_SERVICE_URL=http://localhost:8003
NER_SERVICE_URL=http://localhost:8004
DICT_SERVICE_URL=http://localhost:8005
QA_SERVICE_URL=http://localhost:8006

# Model Paths
ASR_MODEL_PATH=./models/asr/whisper-large-v3-medical
CONTENT_FILTER_MODEL_PATH=./models/content_filter/bert-fa-content-filter
SENTENCE_RANKER_MODEL_PATH=./models/sentence_ranker/ranker-v1
NER_MODEL_PATH=./models/ner/bert-fa-medical-ner
LLM_MODEL_PATH=./models/llm/mixtral-medical-lora

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/ultrasound_db
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_SIZE=104857600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Hugging Face
HF_TOKEN=your-huggingface-token-here
